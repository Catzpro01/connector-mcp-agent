{
  "name": "connector-mcp-agent",
  "version": "0.1.0",
  "description": "Agent-side CLI, background tab multiplexer, and MCP client for remote VPS connector",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "connector-cli": "dist/index.js",
    "connector-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catzpro01/connector-mcp-agent.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "cli",
    "vps",
    "workspace"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run build && npm install -g .",
    "build": "tsc -p tsconfig.json",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
